<?xml version="1.0" encoding="utf-8"?>
<!-- OmarchyTV home. Same view ids and structure as tv-vibehack's launcher; only the styling changed,
     plus the wallpaper, the Waybar-style bar (workspaces / clock / modules) and the wordmark. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tn_bg">

    <com.omarchytv.home.WallpaperView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Top shelf: name of the focused dock app, positioned above the "> Apps" header in code. -->
    <TextView
        android:shadowColor="#99000000"
        android:shadowDy="1.5"
        android:shadowRadius="4"
        android:id="@+id/heroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:alpha="0"
        android:textColor="@color/tn_fg"
        android:textSize="18sp"
       

        android:includeFontPadding="false"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Waybar: workspaces left, clock centre, modules (Inputs, Wi-Fi, Settings) right. -->
        <RelativeLayout
            android:id="@+id/bar"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="@drawable/bar_bg"
            android:paddingStart="20dp"
            android:paddingEnd="14dp">

            <LinearLayout
                android:id="@+id/barLeft"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- The logo is the settings entry point (Omarchy-style menu): focusable, opens the quick menu. -->
                <FrameLayout
                    android:id="@+id/btnMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="10dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:background="@drawable/pill_bg"
                    android:tag="control"
                    android:contentDescription="@string/menu_launcher"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusRight="@+id/btnInputs"
                    android:nextFocusDown="@+id/grid">

                    <ImageView
                        android:id="@+id/barIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/omarchy_icon"
                        android:tint="@drawable/pill_text"
                        android:duplicateParentState="true"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/barMark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        android:text="@string/brand_short"
                        android:textColor="@drawable/pill_text"
                        android:duplicateParentState="true"
                        android:textSize="14sp"
                       
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/workspaces"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerHorizontal="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Omarchy's default clock format: "dddd HH:mm". -->
                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEEE h:mm a"
                    android:format24Hour="EEEE HH:mm"
                    android:textColor="@color/tn_fg"
                    android:textSize="20sp"
                    android:includeFontPadding="false"
                   
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:nextFocusLeft="@+id/btnMenu"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />

                <View style="@style/BarSeparator" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <View style="@style/BarSeparator" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopButton"
                    android:text="@string/settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Wordmark and terminal prompt. -->
        <LinearLayout
            android:id="@+id/leftBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:layout_marginTop="34dp"
            android:orientation="vertical">

            <com.omarchytv.home.WordmarkView
                android:id="@+id/wordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/brand" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/promptUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prompt"
                    android:shadowColor="#99000000"
                    android:shadowDy="1.5"
                    android:shadowRadius="4"
                    android:textColor="@color/tn_green"
                    android:textSize="14sp"
                   
 />

                <View
                    android:id="@+id/cursor"
                    android:layout_width="8.5dp"
                    android:layout_height="17dp"
                    android:layout_marginStart="8.5dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/tn_fg" />
            </LinearLayout>
        </LinearLayout>

        <!-- The wrapper clips at the grid's edge (and fades its top 48dp while scrolled); the grid itself must not
             clip so scaled tiles can overflow their cells. -->
        <com.omarchytv.home.FadeTopFrame
            android:id="@+id/gridFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:paddingStart="56dp"
            android:paddingEnd="56dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </com.omarchytv.home.FadeTopFrame>
    </LinearLayout>

    <!-- Tiled info panes, top right: row 1 = clock / weather / AI credits (+ PC panes that fit), optional row 2 = more PC panes. Built in MainActivity.buildPanes(). -->
    <LinearLayout
        android:id="@+id/panes"
        android:baselineAligned="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="56dp"
        android:gravity="end"
        android:orientation="vertical" />

    <!-- Move-mode hint. -->
    <TextView
        android:id="@+id/moveHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="44dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@drawable/hint_bg"
        android:textColor="@color/tn_orange"
        android:textSize="14sp"
       
        android:visibility="gone" />

    <!-- The single floating Hyprland-style focus border that springs between tiles. -->
    <com.omarchytv.home.FocusFrameView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
