<?xml version="1.0" encoding="utf-8"?>
<!-- Section header ("> tv"): a 1px hairline above for separation, then the prompt; no box.
     The cursor blinks while the section has focus. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="30dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:background="@color/tn_selection" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:paddingStart="14dp"
        android:minHeight="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:shadowColor="#99000000"
            android:shadowDy="1.5"
            android:shadowRadius="4"
            android:id="@+id/promptText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            />

        <TextView
            android:shadowColor="#99000000"
            android:shadowDy="1.5"
            android:shadowRadius="4"
            android:id="@+id/promptHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textColor="@color/tn_fg_dim"
            android:textSize="14sp"
           
            android:singleLine="true" />

        <View
            android:id="@+id/promptCursor"
            android:layout_width="8dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:background="@color/tn_fg"
            android:visibility="invisible" />
    </LinearLayout>
</LinearLayout>
